# ============================================================================
# Environment variables — contoh. Salin ke `.env` dan isi nilai nyata.
# JANGAN commit `.env` atau kredensial asli.
# ============================================================================

# Koneksi read-only ke database backbone (dipakai Metabase; Laravel TIDAK)
BACKBONE_DB_HOST=127.0.0.1
BACKBONE_DB_PORT=5432
BACKBONE_DB_DATABASE=backbone_client
BACKBONE_DB_USERNAME=admin_full  # Fase 2: role read-only dari database/sql/admin_full_role.sql
BACKBONE_DB_PASSWORD=changeme

# Koneksi Laravel ke DB aplikasi (users/sessions) — DB terpisah dari backbone
APP_DB_CONNECTION=pgsql
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_DATABASE=app_db
APP_DB_USERNAME=app
APP_DB_PASSWORD=changeme

# Metabase (Fase 2)
METABASE_SITE_URL=http://localhost:3000
METABASE_EMBEDDING_SECRET=changeme
METABASE_PUBLIC_DASHBOARD_ID=  # mis. 2 — lihat docs/metabase-ids.md
METABASE_VIP_DASHBOARD_ID=     # mis. 4
METABASE_ADMIN_DASHBOARD_ID=   # mis. 3
METABASE_EMBED_TTL=600

# Kredensial admin Metabase — hanya untuk skrip verifikasi
# (security:scan-pii). Nilai ini memakai field `username` pada API Metabase,
# jadi isi dengan email admin. Session id hasil login hanya disimpan di memori,
# tidak pernah dicetak maupun ditulis ke laporan. Jangan commit nilai nyata.
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=

# Laravel
APP_ENV=local
APP_TIMEZONE=Asia/Makassar
