<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!--
            Sengaja `database`, bukan `array` (default Laravel). Pencegahan
            pemakaian ulang kode TOTP menyimpan timestep kode terakhir yang
            diterima di cache lalu membacanya di bawah lock. Store `array`
            memang menyediakan lock, tetapi isinya hanya hidup di dalam satu
            proses, jadi catatan timestep tidak terbagi antar permintaan.
            Test memakai store yang sama dengan produksi agar sifat keamanan
            itu benar-benar diuji.
        -->
        <env name="CACHE_STORE" value="database"/>
        <!--
            Proxy tepercaya untuk test audit log: hanya 127.0.0.1. Test dapat
            membuktikan bahwa IP klien diambil dari X-Forwarded-For hanya bila
            proxy terdaftar, dan dari REMOTE_ADDR bila tidak.
        -->
        <env name="TRUSTED_PROXIES" value="127.0.0.1"/>
        <env name="DB_HOST" value="pgsql"/><env name="DB_PORT" value="5432"/><env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="testing"/><env name="DB_USERNAME" value="app"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="METABASE_SITE_URL" value="https://metabase.test"/>
        <env name="METABASE_EMBEDDING_SECRET" value="test-secret-yang-cukup-panjang-minimal-32-karakter"/>
        <env name="METABASE_PUBLIC_DASHBOARD_ID" value="2"/>
        <env name="METABASE_VIP_DASHBOARD_ID" value="4"/>
        <env name="METABASE_EMBED_TTL" value="600"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>