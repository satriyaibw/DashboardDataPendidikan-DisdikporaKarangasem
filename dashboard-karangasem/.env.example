APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

APP_TIMEZONE=Asia/Makassar
APP_PORT=8000
FORWARD_DB_PORT=5433
WWWUSER=1000
WWWGROUP=1000

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=app_db
DB_USERNAME=app
DB_PASSWORD=changeme

# Akun admin awal (dipakai oleh DatabaseSeeder; password hanya dari env, jangan hardcode)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Alamat reverse proxy / load balancer yang dipercaya (dipisah koma).
# Kosongkan bila aplikasi diakses langsung — header X-Forwarded-For dari klien
# akan diabaikan agar rate limit login berbasis IP tidak dapat dipalsukan.
# Isi "*" atau CIDR (mis. 172.16.0.0/12) bila dijalankan di belakang proxy.
TRUSTED_PROXIES=

# --- Keamanan (Fase 5) ---
# Paksa skema https pada seluruh URL yang dihasilkan aplikasi (route()/url()).
# Aktifkan hanya setelah TLS tersedia; lokal biarkan false.
FORCE_HTTPS=false

# Header Strict-Transport-Security. Toggle terpisah dari FORCE_HTTPS karena
# HSTS tidak bisa dicabut dari sisi server: nyalakan HANYA setelah domain
# pasti melayani HTTPS. Untuk mencabut, turunkan dulu HSTS_MAX_AGE=0.
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000

# Sertakan direktif `includeSubDomains` pada header HSTS. Default false:
# direktif itu memaksa SELURUH subdomain memakai HTTPS, jadi subdomain yang
# belum TLS akan ditolak sebelum sempat diakses, dan pencabutannya jauh lebih
# lambat daripada pengaktifan. Nyalakan hanya setelah semua subdomain HTTPS.
HSTS_INCLUDE_SUBDOMAINS=false

# Atribut cookie sesi. Nilai ini dibaca oleh config/session.php yang sudah
# ada — Fase 5 hanya melengkap dokumentasi env, tidak mengubah config.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Isi true di produksi (setelah TLS aktif) supaya cookie hanya dikirim via HTTPS.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Metabase — Embedding (Fase 4)
# Secret WAJIB identik dengan MB_EMBEDDING_SECRET_KEY di Metabase (min. 32 karakter).
METABASE_SITE_URL=http://localhost:3000
METABASE_EMBEDDING_SECRET=
METABASE_PUBLIC_DASHBOARD_ID=
METABASE_VIP_DASHBOARD_ID=
METABASE_EMBED_TTL=600

# Kredensial admin Metabase — hanya untuk skrip verifikasi
# (`artisan security:scan-pii`). API Metabase memakai field `username`, jadi
# isi dengan email admin. Session id hasil login hanya disimpan di memori dan
# tidak pernah dicetak/ditulis ke laporan. Jangan commit nilai nyata.
METABASE_ADMIN_EMAIL=
METABASE_ADMIN_PASSWORD=
