# ============================================================================
# Environment variables — Metabase deployment
# Salin ke `.env` dan isi nilai nyata. JANGAN commit `.env`.
# ============================================================================

# --- Metadata database (PostgreSQL untuk data internal Metabase) ---
METABASE_MB_DB_DBNAME=metabase
METABASE_MB_DB_USER=metabase
METABASE_MB_DB_PASS=changeme  # Ganti dengan password kuat

# --- Embedding Secret (WAJIB, min. 32 karakter) ---
# Generate: openssl rand -hex 32
# Secret ini harus SAMA dengan METABASE_EMBEDDING_SECRET di Laravel (Fase 4)
METABASE_MB_EMBEDDING_SECRET_KEY=changeme_min_32_chars

# --- Site URL (untuk public link & embed) ---
METABASE_SITE_URL=http://localhost:3000

# --- Encryption secret untuk kredensial koneksi DB (WAJIB, min. 16 karakter) ---
# Generate: openssl rand -base64 32
# PENTING: simpan baik-baik; kalau hilang/diubah, kredensial koneksi DB di
# Admin Panel harus di-set ulang.
METABASE_MB_ENCRYPTION_SECRET_KEY=changeme_min_16_chars
